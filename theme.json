{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "primary", "name": "Primary", "color": "#47687b" },
				{ "slug": "light", "name": "Light", "color": "#f2f6f8" },
				{ "slug": "dark", "name": "Dark", "color": "#1e1e1e" },
				{ "slug": "white", "name": "White", "color": "#ffffff" }
			]
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1600px"
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [ "px", "rem" ]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"fontFamily": "Inter, sans-serif",
					"name": "Inter",
					"slug": "inter"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.85rem", "name": "Small" },
				{ "slug": "medium", "size": "1rem", "name": "Medium" },
				{ "slug": "large", "size": "1.6rem", "name": "Large" }
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|inter"
		}
	}
}
